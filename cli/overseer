#!/usr/bin/env sh
# Overseer Kit CLI — POSIX shim → python -m cli.main (init|sync|status|review|governance-sync).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
if [ -x "$ROOT/.venv/bin/python3" ]; then
  exec "$ROOT/.venv/bin/python3" -m cli.main "$@"
fi
exec python3 -m cli.main "$@"

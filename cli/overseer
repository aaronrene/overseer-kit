#!/usr/bin/env sh
# Overseer Kit CLI — K4 will implement init|sync|status|governance-sync|review
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
VERSION="$(cat "$ROOT/VERSION" 2>/dev/null || echo unknown)"
CMD="${1:-status}"
case "$CMD" in
  init|sync|status|governance-sync|review)
    echo "overseer-kit $VERSION: '$CMD' not implemented yet (K4/K5/9A-5)."
    echo "See docs/ROADMAP.md — next build phase: K2 VCS adapters."
    exit 2
    ;;
  -h|--help|help)
    echo "Usage: overseer {init|sync|status|governance-sync|review} ..."
    exit 0
    ;;
  *)
    echo "unknown command: $CMD" >&2
    exit 1
    ;;
esac

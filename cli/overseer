#!/usr/bin/env sh
# Overseer Kit CLI — dispatches init|sync|status to the Python runtime (K4b).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
if [ -x "$ROOT/.venv/bin/python3" ]; then
  exec "$ROOT/.venv/bin/python3" -m cli.main "$@"
fi
exec python3 -m cli.main "$@"

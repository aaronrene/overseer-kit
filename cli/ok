#!/bin/sh
set -eu
PATH=/usr/bin:/bin
export PATH
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
ROOT=$(CDPATH= cd -P -- "$(/usr/bin/dirname -- "$0")/.." && pwd -P)
if [ ! -x "$ROOT/.venv/bin/python3" ]; then
  echo 'refused: create this installation’s .venv; no runtime fallback' >&2
  exit 2
fi
exec "$ROOT/.venv/bin/python3" -I -B "$ROOT/cli/bootstrap.py" "$@"
